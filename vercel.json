{
  "redirects": [
    { "source": "/fogon", "destination": "/fogon/", "permanent": false },
    { "source": "/fogon/panel(.*)", "destination": "/fogon/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/fogon/", "destination": "/fogon-intro.html" },
    { "source": "/fogon/carta", "destination": "https://levx-fogon-de-ruta.vercel.app/index.html" },
    { "source": "/fogon/:path+", "destination": "https://levx-fogon-de-ruta.vercel.app/:path+" }
  ]
}
